# Keep the build context small and the image free of things it cannot use.

.git/
.github/
.gitattributes
.gitignore

tests/
reports/
.vscode/

**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.venv/
venv/
env/

*.md
LICENSE
docker-compose.yml
Dockerfile
Makefile
pyproject.toml

# Intermediate training checkpoints and TensorBoard logs, if a local run left
# any behind.
models/**/checkpoint-*/
models/**/runs/

# Large weights are fetched from object storage during the build (see the
# FETCH_MODELS build arg), never copied from the context - otherwise every local
# build would push half a gigabyte into the daemon before doing anything.
models/**/*.keras
models/roberta/model.safetensors
models/roberta/training_args.bin
