# Normalise line endings so Windows and Linux contributors stop fighting.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Large binary model artifacts tracked with Git LFS.
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.keras       filter=lfs diff=lfs merge=lfs -text
*.h5          filter=lfs diff=lfs merge=lfs -text
*.bin         filter=lfs diff=lfs merge=lfs -text

# *.joblib is deliberately NOT in LFS. The LR pipeline is ~600 KB and the
# tokenizers ~1.8 MB, so LFS would only add bandwidth cost and the pointer-stub
# failure mode. Keeping them as ordinary blobs means a plain `git clone` with no
# `git lfs pull` still gets a working Logistic Regression model - which the CI
# container job relies on when it asserts a real prediction.
